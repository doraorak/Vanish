<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>defaults</key>
	<string>com.doraorak.vanish</string>
	<key>title</key>
	<string>Vanish</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>General</string>
			<key>footerText</key>
			<string>Enable or disable Vanish window close animations.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>key</key>
			<string>enabled</string>
			<key>label</key>
			<string>Enabled</string>
			<key>PostNotification</key>
			<string>com.doraorak.vanish/prefsChanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Appearance</string>
			<key>footerText</key>
			<string>Include window drop shadows during close animations. Disabling shadows eliminates the double-shadow effect while holding the close button.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>key</key>
			<string>shadows</string>
			<key>label</key>
			<string>Window Shadows</string>
			<key>PostNotification</key>
			<string>com.doraorak.vanish/prefsChanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Refresh Rate</string>
			<key>footerText</key>
			<string>Animation frame rate. 120 Hz provides ultra-smooth animations on ProMotion displays; 60 Hz conserves power. 'Auto' dynamically syncs with the display's native refresh rate.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>default</key>
			<string>auto</string>
			<key>key</key>
			<string>refreshRate</string>
			<key>label</key>
			<string>Refresh Rate</string>
			<key>validTitles</key>
			<array>
				<string>Auto</string>
				<string>120 Hz</string>
				<string>60 Hz</string>
			</array>
			<key>validValues</key>
			<array>
				<string>auto</string>
				<string>120</string>
				<string>60</string>
			</array>
			<key>PostNotification</key>
			<string>com.doraorak.vanish/prefsChanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Animation Duration</string>
			<key>footerText</key>
			<string>Duration of the close animation in seconds (default: 0.25s).</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>default</key>
			<real>0.25</real>
			<key>min</key>
			<real>0.05</real>
			<key>max</key>
			<real>2.0</real>
			<key>showValue</key>
			<true/>
			<key>key</key>
			<string>duration</string>
			<key>label</key>
			<string>Duration</string>
			<key>PostNotification</key>
			<string>com.doraorak.vanish/prefsChanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Target Application</string>
			<key>footerText</key>
			<string>Set to 'all' to animate all closing application windows, or specify an application name (e.g. 'Messages', 'Mail', 'TweakInject', 'VanishTest').</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>default</key>
			<string>all</string>
			<key>placeholder</key>
			<string>all</string>
			<key>key</key>
			<string>targetApp</string>
			<key>label</key>
			<string>Target App</string>
			<key>PostNotification</key>
			<string>com.doraorak.vanish/prefsChanged</string>
		</dict>
	</array>
</dict>
</plist>
