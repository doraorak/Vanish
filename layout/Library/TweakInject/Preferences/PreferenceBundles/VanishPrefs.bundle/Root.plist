<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>defaults</key>
	<string>com.doraorak.vanish</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Enable or disable Vanish window close animations.</string>
			<key>label</key>
			<string>General</string>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.doraorak.vanish/prefsChanged</string>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>key</key>
			<string>enabled</string>
			<key>label</key>
			<string>Enabled</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Which close animation to play. Takes effect on the next window you close.</string>
			<key>label</key>
			<string>Animation</string>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.doraorak.vanish/prefsChanged</string>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>default</key>
			<string>shrink</string>
			<key>key</key>
			<string>animation</string>
			<key>label</key>
			<string>Animation</string>
			<key>validTitles</key>
			<array>
				<string>Shrink</string>
				<string>Squish</string>
				<string>Fall</string>
				<string>Swirl</string>
				<string>Flip</string>
				<string>Tilt</string>
				<string>Slide</string>
				<string>Genie</string>
				<string>Flag</string>
				<string>Spin</string>
				<string>Roll</string>
				<string>Barrel</string>
				<string>Clock</string>
			</array>
			<key>validValues</key>
			<array>
				<string>shrink</string>
				<string>squish</string>
				<string>fall</string>
				<string>swirl</string>
				<string>flip</string>
				<string>tilt</string>
				<string>slide</string>
				<string>genie</string>
				<string>flag</string>
				<string>spin</string>
				<string>roll</string>
				<string>barrel</string>
				<string>clock</string>
			</array>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Include window drop shadows during close animations. Disabling shadows eliminates the double-shadow effect while holding the close button.</string>
			<key>label</key>
			<string>Appearance</string>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.doraorak.vanish/prefsChanged</string>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>key</key>
			<string>shadows</string>
			<key>label</key>
			<string>Window Shadows</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Frame rate for the close animation (default: 120 Hz). Set to 0 to follow the display’s own refresh rate. Low values produce visible frame stepping.</string>
			<key>label</key>
			<string>Refresh Rate</string>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.doraorak.vanish/prefsChanged</string>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>default</key>
			<real>120.0</real>
			<key>key</key>
			<string>refreshRate</string>
			<key>label</key>
			<string>Refresh Rate</string>
			<key>max</key>
			<real>120.0</real>
			<key>min</key>
			<real>0.0</real>
			<key>showValue</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Duration of the close animation in seconds (default: 0.25s).</string>
			<key>label</key>
			<string>Animation Duration</string>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.doraorak.vanish/prefsChanged</string>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>default</key>
			<real>0.25</real>
			<key>key</key>
			<string>duration</string>
			<key>label</key>
			<string>Duration</string>
			<key>max</key>
			<real>2.0</real>
			<key>min</key>
			<real>0.05</real>
			<key>showValue</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Set to 'all' to animate all closing application windows, or specify an application name (e.g. 'Messages', 'Mail', 'TweakInject', 'VanishTest').</string>
			<key>label</key>
			<string>Target Application</string>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.doraorak.vanish/prefsChanged</string>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>default</key>
			<string>all</string>
			<key>key</key>
			<string>targetApp</string>
			<key>label</key>
			<string>Target App</string>
			<key>placeholder</key>
			<string>all</string>
		</dict>
	</array>
	<key>title</key>
	<string>Vanish</string>
</dict>
</plist>
